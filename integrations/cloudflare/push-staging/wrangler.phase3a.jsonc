{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "salero-push-staging",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "ENVIRONMENT": "staging",
    "CODE_SHA": "2b75901f5275234fcf1b0b1bd918bdee4f69d60d",
    "GITHUB_OWNER": "UNCONFIGURED",
    "GITHUB_REPOSITORY": "salero-editorial-snapshots-staging"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "EditorialCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "EditorialCoordinator"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "account_id": "0bd72789f683471596f05b6d0c4653fc",
  "preview_urls": false,
  "routes": [],
  "triggers": {
    "crons": []
  }
}
